{
  "name": "@tastyfood/api",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:concurrency": "dotenv -e ../../.env.test -- vitest run --config vitest.concurrency.config.js",
    "db:generate": "prisma generate",
    "db:validate": "dotenv -e ../../.env -- prisma validate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:seed": "dotenv -e ../../.env -- node prisma/seed.js",
    "db:studio": "dotenv -e ../../.env -- prisma studio",
    "db:reset": "dotenv -e ../../.env -- prisma migrate reset --force",
    "db:test:migrate": "dotenv -e ../../.env.test -- prisma migrate deploy",
    "embeddings:generate": "dotenv -e ../../.env -- node ../../scripts/generate-embeddings.js"
  },
  "prisma": {
    "seed": "dotenv -e ../../.env -- node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "openai": "^7.4.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "rate-limit-redis": "^4.2.0",
    "resend": "^6.18.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.2.1",
    "supertest": "^7.0.0",
    "vitest": "^2.1.8"
  }
}
