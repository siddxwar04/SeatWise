{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://seatwise-api-45ji.onrender.com/api/:path*"
    },
    {
      "source": "/health/:path*",
      "destination": "https://seatwise-api-45ji.onrender.com/health/:path*"
