# ---------------------------------------------------------------------------
# TastyFood — environment template
# Copy to .env and fill in real values. .env is gitignored; this file is not.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:5173

# --- Database ---------------------------------------------------------------
# REQUIRED. The API will not start without a real Postgres URL.
#
# Option A — Neon (free, no Docker): https://console.neon.tech
#   Create a project → Connection string → paste below.
#   Append ?sslmode=require if Neon does not already include it.
#
# Option B — Docker Compose (local):
#   docker compose up -d postgres redis
#   then use the default below.
#
# Option C — Local PostgreSQL install:
#   Create DB/user tastyfood/tastyfood and use the default below.
DATABASE_URL=postgresql://tastyfood:tastyfood@localhost:5432/tastyfood?schema=public

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Auth -------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
BCRYPT_ROUNDS=12

# --- Restaurant business rules ----------------------------------------------
RESTAURANT_OPEN_HOUR=11
RESTAURANT_CLOSE_HOUR=23
SLOT_MINUTES=30
DINING_DURATION_MINUTES=90
MAX_ADVANCE_BOOKING_DAYS=90

# --- ML service -------------------------------------------------------------
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT_MS=2000

# --- AI (Phase 8) -----------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
AI_RATE_LIMIT_PER_HOUR=20

# --- Email (Phase 9) --------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="TastyFood <no-reply@tastyfood.local>"
