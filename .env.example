# ---------------------------------------------------------------------------
# TastyFood — environment template
# Copy to .env and fill in real values. .env is gitignored; this file is not.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:5173

# --- Database ---------------------------------------------------------------
# REQUIRED. The API will not start without a real Postgres URL.
#
# Option A — Neon (free, no Docker): https://console.neon.tech
#   Create a project → Connection string → paste below.
#   Append ?sslmode=require if Neon does not already include it.
#
# Option B — Docker Compose (local):
#   docker compose up -d postgres redis
#   then use the default below.
#
# Option C — Local PostgreSQL install:
#   Create DB/user tastyfood/tastyfood and use the default below.
DATABASE_URL=postgresql://tastyfood:tastyfood@localhost:5432/tastyfood?schema=public

# Concurrency / integration tests use a separate file: .env.test
# (Postgres on port 5433 via `npm run db:test`). Do not point that at prod.

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Auth -------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string
# Optional today — refresh tokens are opaque DB hashes, not JWTs. Kept for a
# future signed-refresh design; set it if you want the slot reserved.
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
BCRYPT_ROUNDS=12

# --- Restaurant business rules ----------------------------------------------
RESTAURANT_OPEN_HOUR=11
RESTAURANT_CLOSE_HOUR=23
SLOT_MINUTES=30
DINING_DURATION_MINUTES=90
MAX_ADVANCE_BOOKING_DAYS=90
MIN_LEAD_TIME_MINUTES=60
MAX_PARTY_SIZE=10
# Minutes east of UTC for restaurant wall clock (330 = IST). India has no DST.
RESTAURANT_UTC_OFFSET_MINUTES=330

# --- Web (Vite) -------------------------------------------------------------
# Optional. Default venue on the marketing site until a venue picker exists.
# VITE_DEFAULT_RESTAURANT_SLUG=tastyfood-koramangala
# VITE_API_URL=http://localhost:4000

# --- ML service -------------------------------------------------------------
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT_MS=2000

# --- AI (Phase 8) -----------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
AI_RATE_LIMIT_PER_HOUR=20

# --- Email (Phase 9) --------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="TastyFood <no-reply@tastyfood.local>"

# --- Seed (local / demo only) -----------------------------------------------
# Used by `npm run db:seed`. Change before any shared environment.
# SEED_ADMIN_PASSWORD=Admin@12345
# SEED_USER_PASSWORD=Guest@12345
