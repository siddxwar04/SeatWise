# ---------------------------------------------------------------------------
# TastyFood — test database env (safe to commit; no real secrets)
# Used by: npm run db:test:migrate / npm run test:concurrency
# ---------------------------------------------------------------------------
NODE_ENV=test
DATABASE_URL=postgresql://tastyfood:tastyfood@localhost:5433/tastyfood_test?schema=public&connection_limit=30

JWT_ACCESS_SECRET=test-access-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=test-refresh-secret-at-least-32-characters-long
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
BCRYPT_ROUNDS=10

WEB_ORIGIN=http://localhost:5173
REDIS_URL=redis://localhost:6379

RESTAURANT_OPEN_HOUR=11
RESTAURANT_CLOSE_HOUR=23
SLOT_MINUTES=30
DINING_DURATION_MINUTES=90
MAX_ADVANCE_BOOKING_DAYS=90
# Concurrency tests book a near-future slot; lead time would reject them.
MIN_LEAD_TIME_MINUTES=0
MAX_PARTY_SIZE=10
RESTAURANT_UTC_OFFSET_MINUTES=330

ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT_MS=2000
